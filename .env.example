# Names and placeholders only. Set real values directly in Render.
TORBOX_API_KEY=
# Generate this locally in your browser at /setup. Do not commit the real hash.
HOUSEHOLD_PASSWORD_HASH=
# Render provides RENDER_EXTERNAL_URL automatically; overrides are optional.
PUBLIC_ORIGIN=
PORT=10000
NODE_ENV=production
# TorBox-owned CDN suffixes verified from TorBox's published support guidance.
MEDIA_HOST_SUFFIXES=torbox.app,tb-cdn.cx,tb-cdn.io,tb-cdn.pw,tb-cdn.sh,tb-cdn.st,tb-cdn.to,tb-cdn.earth
# Diagnostic only. Keep disabled during normal use.
TORBOX_VERIFY_ON_START=0
# Reserved for the durable-player phase. NOT implemented in v0.2.0.
# DATABASE_URL=
