# Names and placeholders only. Set real values directly in Render.
TORBOX_API_KEY=
# Generate this locally in your browser at /setup. Do not commit the real hash.
HOUSEHOLD_PASSWORD_HASH=
# Render provides RENDER_EXTERNAL_URL automatically; overrides are optional.
PUBLIC_ORIGIN=
PORT=10000
NODE_ENV=production
# Default allows only TorBox-owned HTTPS media hosts. Expand only after verification.
MEDIA_HOST_SUFFIXES=torbox.app
# Reserved for the durable-player phase. NOT implemented in v0.1.0.
# DATABASE_URL=
